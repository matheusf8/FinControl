# Copie este arquivo para backend/.env e ajuste os valores.
# O .env real nunca vai pro git (está no .gitignore).

# JWT — gere uma chave forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-secrets.token_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Banco de dados: por padrão já usa um arquivo SQLite dentro de backend/,
# então normalmente não precisa mexer nesta linha em dev local.
# Em produção (Render), aponta pra um Postgres (ex: Neon):
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.neon.tech/fincontrol?sslmode=require
# DATABASE_URL=sqlite:///./fincontrol.db

# CORS: origens liberadas a chamar a API, separadas por vírgula.
# Em dev local não precisa mexer (default já cobre o Vite). Em produção,
# coloca a URL do frontend no Vercel:
# CORS_ORIGINS=https://seu-projeto.vercel.app
