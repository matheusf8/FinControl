# Copie este arquivo para backend/.env e ajuste os valores.
# O .env real nunca vai pro git (está no .gitignore).

# JWT — gere uma chave forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-secrets.token_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Banco de dados: por padrão já usa um arquivo SQLite dentro de backend/,
# então normalmente não precisa mexer nesta linha.
# DATABASE_URL=sqlite:///./fincontrol.db
